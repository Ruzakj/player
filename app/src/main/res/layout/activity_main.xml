<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <LinearLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/player_glass_panel"
            android:paddingStart="7dp"
            android:paddingEnd="7dp">

            <Button
                android:id="@+id/back"
                style="@style/PlayerIconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="‹"
                android:textSize="25sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/mediaTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="RIC Player"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Now playing"
                    android:textColor="#99FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <Button
                android:id="@+id/subtitleTop"
                style="@style/PlayerIconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="7dp"
                android:text="CC"
                android:textSize="11sp" />

            <Button
                android:id="@+id/pip"
                style="@style/PlayerIconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="▣"
                android:textSize="17sp" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/centerControls"
            android:layout_width="wrap_content"
            android:layout_height="72dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/player_glass_panel"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <Button
                android:id="@+id/previous"
                style="@style/PlayerIconButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:text="|‹"
                android:textSize="16sp" />

            <Button
                android:id="@+id/rewind"
                style="@style/PlayerIconButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="7dp"
                android:text="-10"
                android:textSize="12sp" />

            <Button
                android:id="@+id/playPause"
                style="@style/PlayerIconButton"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="9dp"
                android:text="▶"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/forward"
                style="@style/PlayerIconButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:text="+10"
                android:textSize="12sp" />

            <Button
                android:id="@+id/next"
                style="@style/PlayerIconButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="7dp"
                android:text="›|"
                android:textSize="16sp" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/player_glass_panel"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="9dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/currentTime"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#EFFFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressTint="#FFFFFFFF"
                    android:thumbTint="#FFFFFFFF"
                    android:progressBackgroundTint="#45FFFFFF" />

                <TextView
                    android:id="@+id/duration"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="00:00"
                    android:textColor="#AFFFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:fillViewport="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/toolRow"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/openFile"
                        style="@style/PlayerPillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="File" />

                    <Button
                        android:id="@+id/openUrl"
                        style="@style/PlayerPillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="7dp"
                        android:text="URL" />

                    <Button
                        android:id="@+id/speed"
                        style="@style/PlayerPillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="7dp"
                        android:text="1.0x" />

                    <Button
                        android:id="@+id/subtitle"
                        style="@style/PlayerPillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="7dp"
                        android:text="Subtitle" />

                    <Button
                        android:id="@+id/audioTrack"
                        style="@style/PlayerPillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="7dp"
                        android:text="Audio" />

                    <Button
                        android:id="@+id/scaling"
                        style="@style/PlayerPillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="7dp"
                        android:text="Fit" />

                    <Button
                        android:id="@+id/orientation"
                        style="@style/PlayerPillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="7dp"
                        android:text="Auto" />

                    <Button
                        android:id="@+id/lock"
                        style="@style/PlayerPillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="7dp"
                        android:text="Lock" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/gestureIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/player_glass_panel"
        android:paddingStart="26dp"
        android:paddingTop="16dp"
        android:paddingEnd="26dp"
        android:paddingBottom="16dp"
        android:gravity="center"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <Button
        android:id="@+id/unlock"
        style="@style/PlayerPillButton"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="18dp"
        android:text="Unlock"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/errorState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="22dp"
        android:background="@drawable/player_glass_panel"
        android:paddingStart="16dp"
        android:paddingTop="11dp"
        android:paddingEnd="16dp"
        android:paddingBottom="11dp"
        android:textColor="#FFFFD6D6"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
